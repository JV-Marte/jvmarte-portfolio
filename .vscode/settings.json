{
  // Build output — generated by `next build`, never edited by hand.
  // Hidden from the explorer and search, and excluded from the file watcher.
  "files.exclude": {
    "**/.next": true,
    "**/out": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/out": true,
    "**/node_modules": true,
    "**/package-lock.json": true
  },
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/out/**": true,
    "**/node_modules/**": true
  },
  // `.next/trace` is NDJSON (one JSON array per line), so the JSON parser
  // reports "End of file expected." on line 2. It is not JSON — treat as text.
  "files.associations": {
    "**/.next/trace": "plaintext"
  }
}
